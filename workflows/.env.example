# ── ClinOps Weekly Sync workflow ────────────────────────────────────────────

# Granola API token — Granola app > Settings > API
GRANOLA_API_TOKEN=your_granola_api_token_here

# Slack bot token — https://api.slack.com/apps
# Required bot scopes: chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-...

# Linear personal API key — https://linear.app/settings/api
LINEAR_API_KEY=lin_api_...

# Override which Linear team to file issues under (default: Clinical)
# LINEAR_CLINOPS_TEAM_NAME=Clinical

# Override the Granola meeting title to match (default: ClinOps Weekly Sync)
# GRANOLA_MEETING_TITLE=ClinOps Weekly Sync


# ── Daily Availability Report workflow ───────────────────────────────────────

# Metabase - https://metabase.vitablehealth.com
METABASE_URL=https://metabase.vitablehealth.com
METABASE_USERNAME=you@example.com
METABASE_PASSWORD=your_metabase_password

# Supabase — service_role key bypasses RLS, so the workflow can write all tables
SUPABASE_URL=https://bbquooftytwprllipcsb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Homebase API — Homebase Settings > Integrations > API
HOMEBASE_API_KEY=your_homebase_api_key_here
HOMEBASE_LOCATION_IDS=loc_1,loc_2

# Slack channel for daily report (defaults to #appointment-availability-update)
SLACK_CHANNEL_ID=C08A03ET7C3

# Optional: override the report date (defaults to today in America/Chicago)
# REPORT_DATE=2026-05-04

# Optional: dry-run prints to stdout instead of posting to Slack
# DRY_RUN=1


# ── Sync Provider Utilization workflow ───────────────────────────────────────

# Metabase card IDs and column names — set these as repo *Variables*
# (Settings → Secrets and variables → Actions → Variables tab) in production.
# Listed here so local runs don't fail.
METABASE_DAILY_UTIL_CARD_ID=
METABASE_5WK_UTIL_CARD_ID=
UTIL_NAME_COLUMN=
UTIL_PCT_COLUMN=
